{
  "name": "agent-memory-site",
  "version": "0.1.0",
  "description": "Turn Markdown/Obsidian AI-agent memory vaults into semantic HTML dashboards, search indexes, and retrieval-ready JSONL chunks.",
  "type": "module",
  "bin": {
    "agent-memory": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && node dist/cli/index.js build --source examples/sample-vault --out examples/sample-site --mode private",
    "dev": "tsx src/cli/index.ts serve --source examples/sample-vault --out examples/sample-site",
    "serve": "node dist/cli/index.js serve --source examples/sample-vault --out examples/sample-site",
    "validate": "tsx src/cli/index.ts validate --source examples/sample-vault",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm test && npm run build && npm pack --dry-run"
  },
  "keywords": [
    "ai-agent",
    "agent-memory",
    "memory",
    "markdown",
    "obsidian",
    "semantic-html",
    "static-site",
    "static-site-generator",
    "rag",
    "retrieval",
    "jsonl",
    "knowledge-base",
    "llm",
    "claude",
    "codex",
    "local-first",
    "privacy",
    "typescript",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikopastore/agent-memory-site.git"
  },
  "bugs": {
    "url": "https://github.com/nikopastore/agent-memory-site/issues"
  },
  "homepage": "https://github.com/nikopastore/agent-memory-site#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "assets",
    "docs",
    "templates",
    "examples/sample-vault",
    "agent-memory.config.json"
  ]
}
